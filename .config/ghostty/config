# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 10
# adjust-cell-width = "-10%"

# Window settings
background-opacity = 0.96
background-blur = true
macos-non-native-fullscreen = false
macos-titlebar-style = hidden
window-height = 65
window-width = 240
window-padding-x = 8
window-padding-y = 8

# Focus follows mouse
focus-follows-mouse = true

# macOS Option key as Alt
macos-option-as-alt = true

# shell integration settings
shell-integration-features = ssh-env

# Cursor
cursor-style = block
cursor-color = 81c784

# Tab settings
gtk-tabs-location = hidden

# Keybindings
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+left=goto_split:previous
keybind = super+right=goto_split:next
keybind = super+l=goto_split:next
keybind = super+shift+left=resize_split:left,10
keybind = super+shift+right=resize_split:right,10
keybind = super+shift+up=resize_split:up,10
keybind = super+shift+down=resize_split:down,10
keybind = shift+enter=text:\x1b\r

# Omarchy theme color
config-file = ~/.local/state/omarchy/current/theme/ghostty.conf

