#!/usr/bin/env bash

# gdate on macOS (via `brew install coreutils`) for GNU date semantics;
# linux ships GNU date as the system `date`, so the fallback works natively.
date_cmd=$(command -v gdate || command -v date)

today=$($date_cmd +"%Y-%m-%d")
tomorrow=$($date_cmd -d "tomorrow" '+%Y-%m-%d')
yesterday=$($date_cmd -d "yesterday" '+%Y-%m-%d')
file="$HOME"'/notes/01-daily/'"$today".md

cd "$HOME"/notes || exit

new_note() {
    touch "$file"

    # format with daily template
    cat <<EOF >"$file"
# $today

[[$yesterday]] - [[$tomorrow]]

## EOD

*What did I achieve today?*
- 

*What do I want to achieve tomorrow?*
-

## LOG
EOF

}

# if the daily note does not exist create a new one
if [ ! -f "$file" ]; then
    echo "creating a new daily note..."
    new_note
fi

# open the daily note in nvim
nvim "$file"
