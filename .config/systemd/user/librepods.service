[Unit]
Description=librepods (AirPods integration)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/librepods
# librepods occasionally SIGSEGVs on AirPods disconnect (upstream bug).
# Auto-restart so it self-heals instead of needing a manual kill/restart.
Restart=always
RestartSec=2
# Don't give up if BlueZ isn't ready yet at login, or on repeated crashes.
StartLimitIntervalSec=0

[Install]
WantedBy=graphical-session.target
